# Configuração de desenvolvimento do Full Hub.
#
# Estas duas chaves são PÚBLICAS por definição: o Next.js embute qualquer
# variável NEXT_PUBLIC_* no JavaScript que vai para o navegador, então elas
# são legíveis por qualquer visitante de qualquer jeito. É o RLS no Postgres
# que protege os dados, não o segredo destas chaves.
#
# O que NUNCA entra aqui (nem em lugar nenhum do repositório):
#   - a service_role / sb_secret_* — ignora o RLS e dá acesso total ao banco.
#     Ela vive só nas Edge Functions, injetada pela plataforma.
NEXT_PUBLIC_SUPABASE_URL=https://bqrxokpphvvblrturuuh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_I_cmr8L-kuJjLEV6981A7w_OEDJTmBz

# Usado apenas para montar os links de recuperação de senha. No Codespaces, a
# URL real é outra (…app.github.dev) — o login por senha funciona igual.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
